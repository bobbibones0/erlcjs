{
  "name": "@erlcjs/presets",
  "description": "Pre-built moderation, punishment, and utility presets for @erlcjs/core",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "keywords": [ "erlc", "roblox", "prc", "api" ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "homepage": "https://erlcjs.xyz",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noinkin/erlcapi.git",
    "directory": "packages/presets"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "lint": "eslint src/**/*.ts",
    "extract": "api-extractor run --local",
    "test": "vitest run",
    "bench": "pnpm tsx src/index.bench.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@erlcjs/core": "1.3.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}